<?php

namespace App\DataTables;

use App\Models\{{modelName}};
use Illuminate\Database\Eloquent\Builder as QueryBuilder;
use Yajra\DataTables\EloquentDataTable;
use Yajra\DataTables\Html\Builder as HtmlBuilder;
use Yajra\DataTables\Html\Button;
use Yajra\DataTables\Html\Column;
use Yajra\DataTables\Services\DataTable;

class {{modelName}}DataTable extends DataTable
{
    /**
     * Build DataTable response.
     */
    public function dataTable(
        QueryBuilder $query
    ): EloquentDataTable {

        return (new EloquentDataTable($query))

            ->addColumn('action', function ($row) {

                return '
                    <div class="d-flex justify-content-center gap-1">

                        <a
                            href="' . route(
                                '{{modelRoutePrefix}}.edit',
                                $row->id
                            ) . '"
                            class="btn btn-sm btn-info"
                            title="Edit"
                        >
                            <span class="material-symbols-outlined">
                                edit
                            </span>
                        </a>

                        <button
                            type="button"
                            class="btn btn-sm btn-danger"
                            data-confirm-delete="true"
                            data-url="' . route(
                                '{{modelRoutePrefix}}.destroy',
                                $row->id
                            ) . '"
                            title="Hapus"
                        >
                            <span class="material-symbols-outlined">
                                delete
                            </span>
                        </button>

                    </div>
                ';
            })

            /*
             * Allow HTML from action column.
             */
            ->rawColumns([
                'action',
            ])

            /*
             * Use database primary key as DataTables row ID.
             */
            ->setRowId('id');
    }

    /**
     * Get query source of DataTable.
     */
    public function query(
        {{modelName}} $model
    ): QueryBuilder {

        return $model->newQuery();
    }

    /**
     * Configure DataTable HTML builder.
     */
    public function html(): HtmlBuilder
    {
        return $this->builder()

            /*
             * Example:
             * Asesi -> asesi-table
             * Asesor -> asesor-table
             */
            ->setTableId(
                '{{modelTableId}}'
            )

            ->columns(
                $this->getColumns()
            )

            /*
             * Server-side AJAX endpoint.
             */
            ->minifiedAjax(
                route('{{modelRoutePrefix}}.index')
            )

            /*
             * Default sorting:
             * column index 1 = name
             */
            ->orderBy(1)

            ->selectStyleSingle()

            ->parameters([

                /*
                 * Custom Bootstrap 5 layout.
                 */
                'dom' =>
                    '<"row mb-3"' .
                        '<"col-md-6 d-flex align-items-center"B>' .
                        '<"col-md-6"f>' .
                    '>' .
                    'rt' .
                    '<"row mt-3"' .
                        '<"col-md-6"i>' .
                        '<"col-md-6 d-flex justify-content-md-end"p>' .
                    '>',

                /*
                 * Let CSS / column configuration
                 * control widths.
                 */
                'autoWidth' => false,

                /*
                 * Responsive DataTable.
                 */
                'responsive' => true,

                /*
                 * Processing indicator.
                 */
                'processing' => true,

                /*
                 * Server-side processing.
                 */
                'serverSide' => true,

                /*
                 * Save DataTable state.
                 */
                'stateSave' => false,

                /*
                 * Language.
                 */
                'language' => [
                    'processing' => '
                        <div class="d-flex align-items-center gap-2">
                            <div
                                class="spinner-border spinner-border-sm text-primary"
                                role="status"
                            ></div>
                            <span>Memuat data...</span>
                        </div>
                    ',

                    'search' => 'Cari:',

                    'lengthMenu' =>
                        'Tampilkan _MENU_ data',

                    'info' =>
                        'Menampilkan _START_ sampai _END_ dari _TOTAL_ data',

                    'infoEmpty' =>
                        'Tidak ada data',

                    'zeroRecords' =>
                        'Data tidak ditemukan',

                    'emptyTable' =>
                        'Belum ada data',

                    'paginate' => [
                        'first' => 'Awal',
                        'last' => 'Akhir',
                        'next' => '›',
                        'previous' => '‹',
                    ],
                ],
            ])

            /*
             * DataTable buttons.
             */
            ->buttons([

                Button::make('excel')
                    ->text(
                        '<span class="material-symbols-outlined align-middle me-1">
                            download
                        </span> Excel'
                    )
                    ->className(
                        'btn btn-success btn-sm'
                    ),

                Button::make('csv')
                    ->text(
                        '<span class="material-symbols-outlined align-middle me-1">
                            description
                        </span> CSV'
                    )
                    ->className(
                        'btn btn-outline-secondary btn-sm'
                    ),

                Button::make('pdf')
                    ->text(
                        '<span class="material-symbols-outlined align-middle me-1">
                            picture_as_pdf
                        </span> PDF'
                    )
                    ->className(
                        'btn btn-danger btn-sm'
                    ),

                Button::make('print')
                    ->text(
                        '<span class="material-symbols-outlined align-middle me-1">
                            print
                        </span> Print'
                    )
                    ->className(
                        'btn btn-primary btn-sm'
                    ),

                Button::make([
                    'text' => '<span class="material-symbols-outlined align-middle">refresh</span>',
                    'className' => 'btn btn-secondary',
                    'action' => 'function (e, dt, node, config) {
                        dt.ajax.reload(null, false);
                    }',
                ])->className('btn btn-secondary'),
            ]);
    }

    /**
     * Get DataTable columns.
     */
    public function getColumns(): array
    {
        return [

            Column::make('id')
                ->title('ID')
                ->width(80)
                ->addClass('text-center'),

            Column::make('name')
                ->title('Nama'),

            Column::computed('action')
                ->title('Aksi')
                ->width(100)
                ->addClass('text-center')
                ->orderable(false)
                ->searchable(false),

        ];
    }

    /**
     * Get filename for export.
     */
    protected function filename(): string
    {
        return '{{modelName}}_' . date('YmdHis');
    }
}