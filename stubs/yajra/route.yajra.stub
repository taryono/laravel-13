<?php

use Illuminate\Support\Facades\Route;
/*
|--------------------------------------------------------------------------
| Application Routes
|--------------------------------------------------------------------------
|
| Here is where you can register all of the routes for an application.
| It's a breeze. Simply tell Laravel the URIs it should respond to
| and give it the controller to call when that URI is requested.
|
 */
Route::group(['prefix' => '{{modelRoutePrefix}}', 'namespace' => 'App\Modules\{{modelName}}\Controllers', 'middleware' => ['web']], function () {
    Route::get('/', ['as' => '{{modelRoutePrefix}}.index', 'uses' => '{{modelName}}Controller@index']);
    Route::any('/search', ['as' => '{{modelRoutePrefix}}.search', 'uses' => '{{modelName}}Controller@search']);
    Route::get('/create', ['as' => '{{modelRoutePrefix}}.create', 'uses' => '{{modelName}}Controller@create']);
    Route::get('/show/{id}', ['as' => '{{modelRoutePrefix}}.show', 'uses' => '{{modelName}}Controller@show']);
    Route::get('/preview/{id}', ['as' => '{{modelRoutePrefix}}.preview', 'uses' => '{{modelName}}Controller@preview']);
    Route::get('/print/{id}', ['as' => '{{modelRoutePrefix}}.print', 'uses' => '{{modelName}}Controller@print']);

    Route::post('/store', ['as' => '{{modelRoutePrefix}}.store', 'uses' => '{{modelName}}Controller@store']);
    Route::get('/edit/{id}', ['as' => '{{modelRoutePrefix}}.edit', 'uses' => '{{modelName}}Controller@edit']);
    Route::put('/update/{id}', ['as' => '{{modelRoutePrefix}}.update', 'uses' => '{{modelName}}Controller@update']);
    Route::delete('/delete/{id}', ['as' => '{{modelRoutePrefix}}.destroy', 'uses' => '{{modelName}}Controller@destroy']);
    
});
